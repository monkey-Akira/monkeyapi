# Copy this file to .env.production on the Linux server, then edit the values.
# Do not commit .env.production.

# Public access URL. Use your real domain after Nginx/HTTPS is ready.
FRONTEND_BASE_URL=https://api.example.com

# The production Compose file always binds the application to 127.0.0.1.
APP_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=monkeyapi-node-1

# MySQL. Use only letters, numbers, underscore, dash, or dot unless you know
# how to URL-encode special characters for SQL_DSN.
MYSQL_USER=root
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_DATABASE=new-api

# Redis. Use only letters, numbers, underscore, dash, or dot.
REDIS_PASSWORD=change_this_redis_password

# Generate on the server with:
#   openssl rand -hex 32
SESSION_SECRET=

# On upgrades, preserve your existing encryption key. Defaults to SESSION_SECRET.
CRYPTO_SECRET=
# Use HTTPS in production. The trusted origin defaults to FRONTEND_BASE_URL.
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://api.example.com
# Set the actual reverse proxy address or CIDR to enable client IP logging.
TRUSTED_PROXIES=none
